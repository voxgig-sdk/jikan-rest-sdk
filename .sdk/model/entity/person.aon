            }
            {
              var: "id"
            }
            {
              lit: "full"
            }
          ]
          select: {
            "$action": "full"
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}

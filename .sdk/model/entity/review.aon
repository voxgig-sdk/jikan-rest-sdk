          contract: {
            id: "GET /reviews/anime"
            json: "{\"operationId\":\"getRecentAnimeReviews\",\"parameters\":[{\"in\":\"query\",\"name\":\"page\",\"schema\":{\"type\":\"integer\"}},{\"description\":\"Any reviews left during an ongoing anime/manga, those reviews are tagged as preliminary. NOTE: Preliminary reviews are not returned by default so if the entry is airing/publishing you need to add this otherwise you will get an empty list. e.g usage: `?preliminary=true`\",\"in\":\"query\",\"name\":\"preliminary\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Any reviews that are tagged as a spoiler. Spoiler reviews are not returned by default. e.g usage: `?spoiler=true`\",\"in\":\"query\",\"name\":\"spoilers\",\"required\":false,\"schema\":{\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{}}},\"description\":\"Returns recent anime reviews\"},\"400\":{\"description\":\"Error: Bad request. When required parameters were not supplied.\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1

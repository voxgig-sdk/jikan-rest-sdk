          contract: {
            id: "GET /manga"
            json: "{\"operationId\":\"getMangaSearch\",\"parameters\":[{\"description\":\"This is a flag. When supplied it will include entries which are unapproved. Unapproved entries on MyAnimeList are those that are user submitted and have not yet been approved by MAL to show up on other pages. They will have their own specifc pages and are often removed resulting in a 404 error. You do not need to pass a value to it. e.g usage: `?unapproved`\",\"in\":\"query\",\"name\":\"unapproved\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"in\":\"query\",\"name\":\"page\",\"schema\":{\"type\":\"integer\"}},{\"in\":\"query\",\"name\":\"limit\",\"schema\":{\"type\":\"integer\"}},{\"in\":\"query\",\"name\":\"q\",\"schema\":{\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"type\",\"schema\":{\"description\":\"Available Manga types\",\"enum\":[\"manga\",\"novel\",\"lightnovel\",\"oneshot\",\"doujin\",\"manhwa\",\"manhua\"],\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"score\",\"schema\":{\"type\":\"number\"}},{\"description\":\"Set a minimum score for results.\",\"in\":\"query\",\"name\":\"min_score\",\"schema\":{\"type\":\"number\"}},{\"description\":\"Set a maximum score for results\",\"in\":\"query\",\"name\":\"max_score\",\"schema\":{\"type\":\"number\"}},{\"in\":\"query\",\"name\":\"status\",\"schema\":{\"description\":\"Available Manga statuses\",\"enum\":[\"publishing\",\"complete\",\"hiatus\",\"discontinued\",\"upcoming\"],\"type\":\"string\"}},{\"description\":\"Filter out Adult entries\",\"in\":\"query\",\"name\":\"sfw\",\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Filter by genre(s) IDs. Can pass multiple with a comma as a delimiter. e.g 1,2,3\",\"in\":\"query\",\"name\":\"genres\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Exclude genre(s) IDs. Can pass multiple with a comma as a delimiter. e.g 1,2,3\",\"in\":\"query\",\"name\":\"genres_exclude\",\"schema\":{\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"order_by\",\"schema\":{\"description\":\"Available Manga order_by properties\",\"enum\":[\"mal_id\",\"title\",\"start_date\",\"end_date\",\"chapters\",\"volumes\",\"score\",\"scored_by\",\"rank\",\"popularity\",\"members\",\"favorites\"],\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"sort\",\"schema\":{\"description\":\"Search query sort direction\",\"enum\":[\"desc\",\"asc\"],\"type\":\"string\"}},{\"description\":\"Return entries starting with the given letter\",\"in\":\"query\",\"name\":\"letter\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Filter by magazine(s) IDs. Can pass multiple with a comma as a delimiter. e.g 1,2,3\",\"in\":\"query\",\"name\":\"magazines\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Filter by starting date. Format: YYYY-MM-DD. e.g `2022`, `2005-05`, `2005-01-01`\",\"in\":\"query\",\"name\":\"start_date\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Filter by ending date. Format: YYYY-MM-DD. e.g `2022`, `2005-05`, `2005-01-01`\",\"in\":\"query\",\"name\":\"end_date\",\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"allOf\":[{\"properties\":{\"data\":{\"items\":{\"description\":\"Manga Resource\",\"properties\":{\"approved\":{\"description\":\"Whether the entry is pending approval on MAL or not\",\"type\":\"boolean\"},\"authors\":{\"items\":{\"description\":\"Parsed URL Data\",\"properties\":{\"mal_id\":{\"description\":\"MyAnimeList ID\",\"type\":\"integer\"},\"name\":{\"description\":\"Resource Name/Title\",\"type\":\"string\"},\"type\":{\"description\":\"Type of resource\",\"type\":\"string\"},\"url\":{\"description\":\"MyAnimeList URL\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"background\":{\"description\":\"Background\",\"nullable\":true,\"type\":\"string\"},\"chapters\":{\"description\":\"Chapter count\",\"nullable\":true,\"type\":\"integer\"},\"demographics\":{\"items\":{\"description\":\"Parsed URL Data\",\"properties\":
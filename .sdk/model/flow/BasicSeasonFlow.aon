# BasicSeasonFlow

main: kit: flow: BasicSeasonFlow:
{
  entity: "season",
  kind: "basic",
  name: "BasicSeasonFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "season_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "season_ref01",
        srcdatavar: "season_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "season01",
        year: "year01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-season_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSeasonFlow"
}